{
    "name": "vuthaihoc/laravel-db-portable",
    "description": "Portable query builder helpers for JSON numbers, NULLS LAST and JSON counters across PostgreSQL/CockroachDB, MySQL/MariaDB/MatrixOne and SQLite, plus scan, audit and copy tools for switching database drivers",
    "keywords": [
        "laravel",
        "database",
        "portable",
        "json",
        "cockroachdb",
        "matrixone",
        "mysql",
        "postgresql",
        "migration"
    ],
    "homepage": "https://github.com/vuthaihoc/laravel-db-portable",
    "license": "MIT",
    "authors": [
        {
            "name": "vuthaihoc",
            "email": "vuthaihoc.ttud@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.17",
        "laravel/scout": "^11.8",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5",
        "vuthaihoc/cockroachdb-laravel": "^2.4",
        "vuthaihoc/laravel-matrixone": "^1.1"
    },
    "suggest": {
        "vuthaihoc/laravel-matrixone": "MatrixOne database driver",
        "vuthaihoc/cockroachdb-laravel": "CockroachDB database driver",
        "laravel/scout": "db-portable:search-indexes checks and migrates the indexes of Scout models"
    },
    "autoload": {
        "psr-4": {
            "DbPortable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DbPortable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DbPortable\\DbPortableServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --colors",
        "phpstan": "phpstan analyse --memory-limit=-1",
        "cs": "pint --test",
        "cs:fix": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
