includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    ignoreErrors:
        # Query builder macros are closures bound to the builder at runtime.
        -
            identifier: method.notFound
            message: '#Illuminate\\Database\\(Query|Eloquent)\\Builder.*::(whereJsonNumber|incrementJson|sumJson|avgJson|minJson|maxJson|selectAggregateWhere|orderByFullTextRelevance)\(\)#'
        # Library traits (Mirror\Mirrored) are used by applications, not by the package.
        -
            identifier: trait.unused
        # Schema grammar compile methods may return several statements: Blueprint::toSql() merges
        # arrays, as Laravel's own grammars return them; the parent docblocks only say string.
        -
            identifier: method.childReturnType
            path: src/Sqlite/SchemaGrammar.php
        # Laravel 13 types raw SQL as literal-string (Laravel 12 as string). This package builds that
        # SQL itself, from grammar-wrapped identifiers and dialect fragments, with the values bound:
        # the rule does not apply. Unmatched on Laravel 12.
        -
            identifier: argument.type
            message: '#literal-string#'
            reportUnmatched: false
        -
            identifier: generics.notSubtype
            message: '#Illuminate\\Database\\Query\\Expression#'
            reportUnmatched: false
        -
            identifier: return.type
            message: '#Expression<float\|int\|literal-string>#'
            reportUnmatched: false
